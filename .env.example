# Server port (defaults to 3000)
PORT=3000

# Directory for persistent SQLite database and offline PDF snapshots
DATA_DIR=./data

# Optional master password to protect your self-hosted instance.
# Leave empty for open local network / single-user mode.
APP_PASSWORD=

# Optional secret used to sign session tokens (auto-generated in memory if omitted).
SESSION_SECRET=

# Optional Gotenberg URL for full visual webpage-to-PDF rendering via Chromium in Docker
# Example with docker compose --profile full-pdf up -d:
# GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_URL=

# Optional custom OpenAI-compatible AI model (auto-tagging, smart search, TL;DR, YouTube video summaries)
# Works with OpenAI, OpenRouter, DeepSeek, Ollama, vLLM, LM Studio, LiteLLM, etc.
# Examples:
#   AI_API_URL=https://api.openai.com/v1
#   AI_API_URL=https://openrouter.ai/api/v1
#   AI_API_URL=http://host.docker.internal:11434/v1
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Public URL where the app is hosted
APP_URL="http://localhost:3000"
